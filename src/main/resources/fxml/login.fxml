<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inventario.controllers.LoginController"
            stylesheets="@../css/styles.css">
    
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: linear-gradient(to bottom, #f5f5f5, #e0e0e0);">
            
            <HBox alignment="CENTER">
                <Label text="SISTEMA DE INVENTARIO Y POS" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #333;">
                    <font>
                        <Font size="32" />
                    </font>
                </Label>
            </HBox>
            
            <VBox alignment="TOP_CENTER" spacing="25" style="-fx-background-color: white; -fx-border-radius: 10; -fx-border-color: #ddd; -fx-border-width: 1;" 
                  prefWidth="400" prefHeight="350">
                
                <HBox alignment="CENTER" style="-fx-padding: 20 0 10 0;">
                    <Label text="Ingresar al Sistema" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                </HBox>
                
                <VBox spacing="8" style="-fx-padding: 0 30 0 30;">
                    <Label text="Usuario:" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                    <TextField fx:id="usernameField" promptText="Ingrese su usuario" prefHeight="40"/>
                </VBox>
                
                <VBox spacing="8" style="-fx-padding: 0 30 0 30;">
                    <Label text="Contraseña:" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                    <PasswordField fx:id="passwordField" promptText="Ingrese su contraseña" prefHeight="40"/>
                </VBox>
                
                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 20 30 10 30;">
                    <Button fx:id="loginBtn" text="ENTRAR" prefWidth="150" prefHeight="40" 
                            style="-fx-font-size: 14; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;"
                            onAction="#handleLogin"/>
                </HBox>
                
                <Label fx:id="errorLabel" text=""
                       wrapText="true" alignment="CENTER" style="-fx-padding: 0 20 0 20;"/>
                
            </VBox>
            
        </VBox>
    </center>
    
</BorderPane>
