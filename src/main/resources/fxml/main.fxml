<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inventario.controllers.MainController"
            stylesheets="@../css/styles.css">
    
    <!-- Top: Barra de herramientas -->
    <top>
        <HBox spacing="15" style="-fx-background-color: #2c3e50; -fx-padding: 10;" alignment="CENTER_RIGHT">
            <Label fx:id="usuarioLabel" text="Usuario" style="-fx-text-fill: white; -fx-font-size: 12;"/>
            <Label fx:id="horaLabel" text="Hora" style="-fx-text-fill: white; -fx-font-size: 12;"/>
            <Button text="Acerca de" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;" onAction="#handleAcercaDe"/>
            <Button text="Cambiar contraseña" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-cursor: hand;" onAction="#handleCambiarPassword"/>
            <Button fx:id="logoutBtn" text="CERRAR SESIÓN" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" onAction="#handleLogout"/>
        </HBox>
    </top>
    
    <!-- Left: Menú lateral -->
    <left>
        <VBox spacing="0" style="-fx-background-color: #34495e; -fx-padding: 10;" prefWidth="200">
            
            <Label text="MENÚ" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 10;"/>
            <Separator style="-fx-text-fill: #555;"/>
            
            <Button fx:id="btnInventario" text="📦 Inventario" prefWidth="200" prefHeight="40" 
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 12;"
                    onAction="#handleInventario"/>
            
            <Button fx:id="btnVentas" text="💳 Punto de Ventas" prefWidth="200" prefHeight="40" 
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 12; -fx-padding: 5 0 5 0;"
                    onAction="#handleVentas"/>
            
            <Button fx:id="btnClientes" text="👥 Clientes" prefWidth="200" prefHeight="40" 
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 12; -fx-padding: 5 0 5 0;"
                    onAction="#handleClientes"/>
            
            <Button fx:id="btnProveedores" text="🏭 Proveedores" prefWidth="200" prefHeight="40" 
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 12; -fx-padding: 5 0 5 0;"
                    onAction="#handleProveedores"/>
            
            <Button fx:id="btnReportes" text="📊 Reportes" prefWidth="200" prefHeight="40" 
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 12; -fx-padding: 5 0 5 0;"
                    onAction="#handleReportes"/>

            <Button fx:id="btnUsuarios" text="👤 Usuarios" prefWidth="200" prefHeight="40"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 12; -fx-padding: 5 0 5 0;"
                    onAction="#handleUsuarios"/>

            <Button fx:id="btnRespaldos" text="💾 Respaldos" prefWidth="200" prefHeight="40"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 12; -fx-padding: 5 0 5 0;"
                    onAction="#handleRespaldos"/>

        </VBox>
    </left>
    
    <!-- Center: Área principal -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #ecf0f1;">
            
            <!-- Dashboard inicial -->
            <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 20;">
                
                <Label text="Bienvenido al Sistema" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
                
                <HBox spacing="20" alignment="TOP_CENTER">
                    
                    <!-- Card: Productos -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-border-color: #bbb; -fx-padding: 20; -fx-border-radius: 5;" prefWidth="150" prefHeight="120">
                        <Label text="Productos" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                        <Label fx:id="lblProductos" text="0" style="-fx-font-size: 24; -fx-text-fill: #3498db;"/>
                    </VBox>
                    
                    <!-- Card: Ventas -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-border-color: #bbb; -fx-padding: 20; -fx-border-radius: 5;" prefWidth="150" prefHeight="120">
                        <Label text="Ventas Hoy" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                        <Label fx:id="lblVentas" text="0" style="-fx-font-size: 24; -fx-text-fill: #27ae60;"/>
                    </VBox>
                    
                    <!-- Card: Stock Bajo -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-border-color: #bbb; -fx-padding: 20; -fx-border-radius: 5;" prefWidth="150" prefHeight="120">
                        <Label text="Stock Bajo" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                        <Label fx:id="lblStockBajo" text="0" style="-fx-font-size: 24; -fx-text-fill: #e74c3c;"/>
                    </VBox>
                    
                </HBox>
                
            </VBox>
            
        </StackPane>
    </center>
    
</BorderPane>
