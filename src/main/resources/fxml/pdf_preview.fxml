<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inventario.controllers.PdfPreviewController"
            fx:id="rootPane"
            stylesheets="@../css/styles.css"
            style="-fx-background-color: #ecf0f1;">
    
    <top>
        <VBox spacing="5" style="-fx-background-color: #34495e; -fx-padding: 20; -fx-background-radius: 0 0 8 8;">
            <Label fx:id="lblTitulo" text="TITULO DEL REPORTE" 
                   style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="lblSubtitulo" text="Período: --" 
                   style="-fx-font-size: 13; -fx-text-fill: #ecf0f1;"/>
            <Label fx:id="lblFechaGeneracion" text="Generado: --" 
                   style="-fx-font-size: 11; -fx-text-fill: #bdc3c7;"/>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20;">
            <Label text="Previsualización del Reporte" 
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            <Label text="El PDF se generará con el formato profesional que se muestra a continuación." 
                   style="-fx-font-size: 12; -fx-text-fill: #7f8c8d;"/>
            
            <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 4; -fx-border-color: #bdc3c7; -fx-border-width: 1;">
                <TextArea fx:id="txtResumen" 
                          style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-family: 'Courier New'; -fx-font-size: 13; -fx-padding: 0;"
                          editable="false" 
                          wrapText="true"
                          prefRowCount="12"/>
            </VBox>
            
            <Label text="Haga clic en 'Guardar PDF' para generar el documento." 
                   style="-fx-font-size: 11; -fx-text-fill: #95a5a6;"/>
        </VBox>
    </center>
    
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #bdc3c7; -fx-border-width: 1 0 0 0;">
            <Button fx:id="btnCancelar" text="Cancelar" 
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 10 30 10 30; -fx-cursor: hand; -fx-background-radius: 4;"/>
            <Button fx:id="btnGuardarPdf" text="Guardar PDF" 
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 10 30 10 30; -fx-cursor: hand; -fx-background-radius: 4; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>
    
</BorderPane>
