<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inventario.controllers.ReporteInventarioController"
      stylesheets="@../css/styles.css"
      spacing="15" style="-fx-padding: 15;">
    
    <VBox spacing="5" style="-fx-background-color: #34495e; -fx-padding: 15; -fx-background-radius: 8;">
        <Label text="REPORTE DE INVENTARIO" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label fx:id="lblFechaGeneracion" text="Generado: --" style="-fx-font-size: 11; -fx-text-fill: #bdc3c7;"/>
    </VBox>
    
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Buscar:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtBuscar" promptText="Nombre del producto..." prefWidth="300"/>
        
        <Button text="Buscar" onAction="#handleBuscar" 
                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 8 25 8 25; -fx-cursor: hand; -fx-background-radius: 4;"/>
        
        <Button text="Limpiar" onAction="#handleLimpiar" 
                style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-padding: 8 25 8 25; -fx-cursor: hand; -fx-background-radius: 4;"/>
        
        <Button text="Generar" onAction="#handleGenerar" 
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 25 8 25; -fx-cursor: hand; -fx-background-radius: 4;"/>
        
        <Button text="Exportar PDF" onAction="#handleExportar" 
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 25 8 25; -fx-cursor: hand; -fx-background-radius: 4; -fx-font-weight: bold;"/>
    </HBox>
    
    <HBox spacing="15" alignment="CENTER">
        <VBox spacing="3" alignment="CENTER" style="-fx-background-color: #3498db; -fx-padding: 15 30 15 30; -fx-background-radius: 6;">
            <Label text="TOTAL PRODUCTOS" style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.9);"/>
            <Label fx:id="lblTotalProductos" text="0" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>
        
        <VBox spacing="3" alignment="CENTER" style="-fx-background-color: #27ae60; -fx-padding: 15 30 15 30; -fx-background-radius: 6;">
            <Label text="STOCK TOTAL" style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.9);"/>
            <Label fx:id="lblStockTotal" text="0" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>
        
        <VBox spacing="3" alignment="CENTER" style="-fx-background-color: #e67e22; -fx-padding: 15 30 15 30; -fx-background-radius: 6;">
            <Label text="VALOR INVENTARIO" style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.9);"/>
            <Label fx:id="lblValorInventario" text="0.00" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>
        
        <VBox spacing="3" alignment="CENTER" style="-fx-background-color: #e74c3c; -fx-padding: 15 30 15 30; -fx-background-radius: 6;">
            <Label text="STOCK BAJO" style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.9);"/>
            <Label fx:id="lblStockBajo" text="0" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>
    </HBox>
    
    <Label text="Detalle de Productos" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
    
    <TableView fx:id="tablaInventario" VBox.vgrow="ALWAYS" styleClass="dialog-table">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
            <TableColumn fx:id="colNombre" text="Producto" prefWidth="200"/>
            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
            <TableColumn fx:id="colPrecioCompra" text="P. Compra" prefWidth="100"/>
            <TableColumn fx:id="colPrecioVenta" text="P. Venta" prefWidth="100"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="70"/>
            <TableColumn fx:id="colStockMinimo" text="Stock Mín." prefWidth="80"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="80"/>
        </columns>
    </TableView>
    
    <Separator/>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Label text="Sistema de Inventario POS" style="-fx-font-size: 10; -fx-text-fill: #95a5a6;"/>
    </HBox>
    
</VBox>
