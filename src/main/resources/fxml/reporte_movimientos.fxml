<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inventario.controllers.ReporteMovimientosController"
      stylesheets="@../css/styles.css"
      spacing="15" style="-fx-padding: 15;">
    
    <VBox spacing="5" style="-fx-background-color: #34495e; -fx-padding: 15; -fx-background-radius: 8;">
        <Label text="REPORTE DE MOVIMIENTOS" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label fx:id="lblPeriodo" text="Período: --" style="-fx-font-size: 13; -fx-text-fill: #ecf0f1;"/>
        <Label fx:id="lblFechaGeneracion" text="Generado: --" style="-fx-font-size: 11; -fx-text-fill: #bdc3c7;"/>
    </VBox>
    
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Desde:" style="-fx-font-weight: bold;"/>
        <DatePicker fx:id="dateDesde" prefWidth="140"/>
        
        <Label text="Hasta:" style="-fx-font-weight: bold; -fx-padding: 0 0 0 10;"/>
        <DatePicker fx:id="dateHasta" prefWidth="140"/>
        
        <Label text="Tipo:" style="-fx-font-weight: bold; -fx-padding: 0 0 0 10;"/>
        <ComboBox fx:id="cmbTipo" prefWidth="130"/>
        
        <Button text="Generar" onAction="#handleGenerarReporte" 
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 25 8 25; -fx-cursor: hand; -fx-background-radius: 4;"/>
        
        <Button text="Limpiar" onAction="#handleLimpiar" 
                style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-padding: 8 25 8 25; -fx-cursor: hand; -fx-background-radius: 4;"/>
        
        <Button text="Exportar PDF" onAction="#handleExportar" 
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 25 8 25; -fx-cursor: hand; -fx-background-radius: 4; -fx-font-weight: bold;"/>
    </HBox>
    
    <HBox spacing="15" alignment="CENTER">
        <VBox spacing="3" alignment="CENTER" style="-fx-background-color: #27ae60; -fx-padding: 15 25 15 25; -fx-background-radius: 6;">
            <Label text="ENTRADAS" style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.9);"/>
            <Label fx:id="lblTotalEntradas" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>
        
        <VBox spacing="3" alignment="CENTER" style="-fx-background-color: #e74c3c; -fx-padding: 15 25 15 25; -fx-background-radius: 6;">
            <Label text="SALIDAS" style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.9);"/>
            <Label fx:id="lblTotalSalidas" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>
        
        <VBox spacing="3" alignment="CENTER" style="-fx-background-color: #3498db; -fx-padding: 15 25 15 25; -fx-background-radius: 6;">
            <Label text="AJUSTES" style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.9);"/>
            <Label fx:id="lblTotalAjustes" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>
        
        <VBox spacing="3" alignment="CENTER" style="-fx-background-color: #9b59b6; -fx-padding: 15 25 15 25; -fx-background-radius: 6;">
            <Label text="TOTAL MOV." style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.9);"/>
            <Label fx:id="lblTotalMovimientos" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>
    </HBox>
    
    <Label text="Detalle de Movimientos" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
    
    <TableView fx:id="tablaMovimientos" VBox.vgrow="ALWAYS" styleClass="dialog-table">
    
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha y Hora" prefWidth="130"/>
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="180"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="90"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80"/>
            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="220"/>
            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="120"/>
        </columns>
    </TableView>
    
    <Separator/>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Label text="Sistema de Inventario POS" style="-fx-font-size: 10; -fx-text-fill: #95a5a6;"/>
    </HBox>
    
</VBox>
