<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inventario.controllers.ReportesController"
            stylesheets="@../css/styles.css"
            prefHeight="650.0" prefWidth="1100.0">
    
    <HBox spacing="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        
        <VBox spacing="0" style="-fx-background-color: #34495e; -fx-padding: 15;" prefWidth="220">
            
            <Label text="REPORTES" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-padding: 0 0 15 0;"/>
            <Separator style="-fx-background-color: #555; -fx-padding: 0 0 15 0;"/>
            
            <Button text="📊 Ventas" fx:id="btnReporteVentas" 
                    prefWidth="190" prefHeight="45"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15;"
                    onAction="#handleReporteVentas"/>
            
            <Button text="📦 Inventario" fx:id="btnReporteInventario" 
                    prefWidth="190" prefHeight="45"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15;"
                    onAction="#handleReporteInventario"/>
            
            <Button text="🔄 Movimientos" fx:id="btnReporteMovimientos" 
                    prefWidth="190" prefHeight="45"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15;"
                    onAction="#handleReporteMovimientos"/>
            
            <Button text="💰 Ganancias" fx:id="btnReporteGanancias" 
                    prefWidth="190" prefHeight="45"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15;"
                    onAction="#handleReporteGanancias"/>

            <Button text="📋 Cortes de caja"
                    prefWidth="190" prefHeight="45"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15;"
                    onAction="#handleReporteCortes"/>

        </VBox>
        
        <VBox fx:id="contenedorReportes" spacing="15" style="-fx-background-color: #ecf0f1; -fx-padding: 20;" HBox.hgrow="ALWAYS">
            
            <VBox alignment="TOP_CENTER" spacing="30" style="-fx-padding: 50;">
                
                <Label text="Módulo de Reportes" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                
                <Label text="Seleccione un tipo de reporte del menú izquierdo" style="-fx-font-size: 16; -fx-text-fill: #7f8c8d;"/>
                
                <HBox spacing="30" alignment="CENTER" style="-fx-padding: 30 0 0 0;">
                    
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 25; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #ddd;" prefWidth="220">
                        <Label text="📊" style="-fx-font-size: 36;"/>
                        <Label text="Ventas" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                        <Label text="Reporte de ventas por fecha, cliente y producto" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d; -fx-wrap-text: true;"/>
                    </VBox>
                    
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 25; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #ddd;" prefWidth="220">
                        <Label text="📦" style="-fx-font-size: 36;"/>
                        <Label text="Inventario" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                        <Label text="Estado actual del inventario y productos bajo stock" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d; -fx-wrap-text: true;"/>
                    </VBox>
                    
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 25; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #ddd;" prefWidth="220">
                        <Label text="🔄" style="-fx-font-size: 36;"/>
                        <Label text="Movimientos" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                        <Label text="Historial de entradas y salidas de inventario" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d; -fx-wrap-text: true;"/>
                    </VBox>
                    
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 25; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #ddd;" prefWidth="220">
                        <Label text="💰" style="-fx-font-size: 36;"/>
                        <Label text="Ganancias" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                        <Label text="Resumen de ingresos y ganancias del período" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d; -fx-wrap-text: true;"/>
                    </VBox>
                    
                </HBox>
                
            </VBox>
            
        </VBox>
        
    </HBox>
    
</AnchorPane>
